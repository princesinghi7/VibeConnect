PORT=4000

# Claude — get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Grok (xAI) — get a key from https://console.x.ai
XAI_API_KEY=

# Google Sign-In — create an OAuth Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env (same value, both ends verify the same client)
GOOGLE_CLIENT_ID=

# YouTube Data API v3 — get a free key at
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Used to show your real, live subscriber count on the profile page.
YOUTUBE_API_KEY=
